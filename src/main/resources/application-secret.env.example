# application-secret.env.example
# 이 파일을 복사해 실제 값을 채운 뒤 application-secret.env 로 저장하세요.
#   cp application-secret.env.example application-secret.env
# ⚠️ application-secret.env 는 .gitignore 대상입니다. 절대 커밋하지 마세요.

# --- Database ---
DB_URL=
DB_DRIVER_CLASS_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- JPA ---
JPA_DDL_AUTO=
JPA_OPEN_IN_VIEW=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# --- Mail (이메일 인증) ---
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- S3 Bucket ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- OAuth2 (Kakao/Naver) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH2_REDIRECT_BASE_URL=http://localhost:8080
OAUTH2_FRONTEND_REDIRECT_URL=http://localhost:3000

# --- AI Agent ---
AGENT_BASE_URL=http://localhost:8000
AGENT_API_KEY=
